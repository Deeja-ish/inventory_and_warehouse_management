# ==============================================================================
# StockWise - Environment Variables Template
# Copy this file to `backend/.env` and update the values for your setup.
# ==============================================================================

# Django Secret Key (generate one using: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
SECRET_KEY=replace_with_a_secure_random_key

# Set to True for development, False for production
DEBUG=True

# Database Configuration (PostgreSQL)
DATABASE_NAME=inventory_management_db
DATABASE_USER=postgres
DATABASE_PASSWORD=your_postgres_password
DATABASE_HOST=localhost
DATABASE_PORT=5432

